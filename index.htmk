let lang = 'fa';
const STRINGS = {
fa: { white:'سفید', black:'مشکی', turn:'نوبت ', check:'کیش! نوبت ', checkmate:'کیش‌ومات!',
stalemate:'پات!', history:'تاریخچه', achUnlock:'🏆 دستاورد جدید!',
winsMsg:' برنده شد!', resigned:' تسلیم شد', timeup:'وقت تموم شد!', draws:'بازی مساوی شد.' },
en: { white:'White', black:'Black', turn:'Turn: ', check:'Check! ', checkmate:'Checkmate!',
stalemate:'Stalemate!', history:'History', achUnlock:'🏆 Achievement Unlocked!',
winsMsg:' wins!', resigned:' resigned', timeup:"Time's Up!", draws:'Draw.' },
ar: { white:'أبيض', black:'أسود', turn:'دور: ', check:'كش! ', checkmate:'كش مات!',
stalemate:'تعادل!', history:'التاريخ', achUnlock:'🏆 إنجاز جديد!',
winsMsg:' فاز!', resigned:' استسلم', timeup:'انتهى الوقت!', draws:'تعادل.' },
};
const DIR = { fa:'rtl', en:'ltr', ar:'rtl' };

function setLang(l) {
lang = l;
['btnFa','btnEn','btnAr'].forEach(id => document.getElementById(id).classList.remove('active'));
document.getElementById(l==='fa'?'btnFa':l==='en'?'btnEn':'btnAr').classList.add('active');
document.documentElement.lang = l;
document.documentElement.dir = DIR[l];
document.querySelectorAll('[data-fa]').forEach(el => {
const v = el.dataset[l] || el.dataset.fa;
if (el.tagName==='OPTION') el.textContent = v;
else el.textContent = v;
});
updateMenuSubtitle();
if (document.getElementById('skinsScreen').classList.contains('active')) renderSkinGrid();
if (document.getElementById('achScreen').classList.contains('active')) renderAchGrid();
if (G) updateGameUI();
document.querySelectorAll('.mdbtn[data-fa]').forEach(b => b.textContent = b.dataset[l]||b.dataset.fa);
if (l === 'ar') unlockAch('ar_lang');
}

function updateMenuSubtitle() {
const subs = { fa:'شطرنج رویال', en:'Chess Royale', ar:'شطرنج رويال' };
document.getElementById('menuSubtitle').textContent = subs[lang];
}

function t(key) { return (STRINGS[lang]||STRINGS.fa)[key] || key; }

// ============================================================
// THEME
// ============================================================
let darkMode = true;
function setTheme(mode) {
darkMode = mode === 'dark';
document.body.classList.toggle('light-mode', !darkMode);
document.documentElement.classList.toggle('light-mode', !darkMode);
document.getElementById('btnDark').classList.toggle('active', darkMode);
document.getElementById('btnLight').classList.toggle('active', !darkMode);
requestAnimationFrame(() => {
document.documentElement.style.setProperty('--lsq', currentBoard.l);
document.documentElement.style.setProperty('--dsq', currentBoard.d);
});
}
function toggleTheme() { setTheme(darkMode ? 'light' : 'dark'); }

// ============================================================
// AUDIO
// ============================================================
let actx;
function ga(){ if(!actx) actx=new(window.AudioContext||window.webkitAudioContext)(); return actx; }
function snd(type){
if(!S.sound) return;
try{
const c=ga(),o=c.createOscillator(),g=c.createGain();
o.connect(g);g.connect(c.destination);const n=c.currentTime;
if(type==='move'){o.frequency.setValueAtTime(600,n);o.frequency.exponentialRampToValueAtTime(400,n+0.1);g.gain.setValueAtTime(0.15,n);g.gain.exponentialRampToValueAtTime(0.001,n+0.15);o.start(n);o.stop(n+0.15);}
else if(type==='cap'){o.type='sawtooth';o.frequency.setValueAtTime(280,n);o.frequency.exponentialRampToValueAtTime(130,n+0.22);g.gain.setValueAtTime(0.25,n);g.gain.exponentialRampToValueAtTime(0.001,n+0.25);o.start(n);o.stop(n+0.25);}
else if(type==='chk'){o.type='square';o.frequency.setValueAtTime(880,n);o.frequency.setValueAtTime(1100,n+0.1);o.frequency.setValueAtTime(880,n+0.2);g.gain.setValueAtTime(0.18,n);g.gain.exponentialRampToValueAtTime(0.001,n+0.35);o.start(n);o.stop(n+0.35);}
else if(type==='win'){[523,659,784,1047].forEach((f,i)=>o.frequency.setValueAtTime(f,n+i*0.15));g.gain.setValueAtTime(0.25,n);g.gain.exponentialRampToValueAtTime(0.001,n+0.8);o.start(n);o.stop(n+0.8);}
else if(type==='ach'){o.type='sine';[784,988,1174].forEach((f,i)=>o.frequency.setValueAtTime(f,n+i*0.12));g.gain.setValueAtTime(0.18,n);g.gain.exponentialRampToValueAtTime(0.001,n+0.5);o.start(n);o.stop(n+0.5);}
else if(type==='bad'){o.type='square';o.frequency.setValueAtTime(180,n);g.gain.setValueAtTime(0.1,n);g.gain.exponentialRampToValueAtTime(0.001,n+0.1);o.start(n);o.stop(n+0.1);}
else if(type==='menuNav'){o.type='sine';o.frequency.setValueAtTime(520,n);o.frequency.exponentialRampToValueAtTime(680,n+0.08);g.gain.setValueAtTime(0.12,n);g.gain.exponentialRampToValueAtTime(0.001,n+0.12);o.start(n);o.stop(n+0.12);}
else if(type==='menuBack'){o.type='sine';o.frequency.setValueAtTime(680,n);o.frequency.exponentialRampToValueAtTime(440,n+0.1);g.gain.setValueAtTime(0.1,n);g.gain.exponentialRampToValueAtTime(0.001,n+0.12);o.start(n);o.stop(n+0.12);}
else if(type==='menuStart'){o.type='sine';[440,550,660].forEach((f,i)=>o.frequency.setValueAtTime(f,n+i*0.07));g.gain.setValueAtTime(0.18,n);g.gain.exponentialRampToValueAtTime(0.001,n+0.3);o.start(n);o.stop(n+0.3);}
}catch(e){}
}

