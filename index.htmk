<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Chess Royale — Midnight Games</title>

<!-- PWA Manifest -->
<link rel="manifest" href="manifest.json">

<!-- PWA Meta Tags -->
<meta name="application-name" content="Chess Royale">
<meta name="description" content="Chess Royale — بازی شطرنج کلاسیک توسط Midnight Games">
<meta name="theme-color" content="#D4AF37">
<meta name="background-color" content="#08080E">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Chess Royale">
<meta name="msapplication-TileColor" content="#08080E">
<meta name="msapplication-TileImage" content="icons/icon-144.png">

<!-- Icon -->
<link rel="icon" type="image/png" sizes="512x512" href="icons/icon-512.png">
<link rel="apple-touch-icon" href="icons/icon-512.png">
<meta name="msapplication-TileImage" content="icons/icon-512.png">
<style>
@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;700;900&family=Cinzel:wght@400;700;900&family=Inter:wght@300;400;500;600;700&family=Noto+Kufi+Arabic:wght@400;700;900&display=swap');

:root {
--gold:#D4AF37;--gold-l:#F5D060;--gold-d:#9A7D0A;
--bg:#08080E;--surf:#111118;--surf2:#18181F;--surf3:#202028;
--text:#F0EAD6;--text-dim:#7A7068;
--lsq:#F0D9B5;--dsq:#B58863;
--hi:rgba(212,175,55,0.55);--chk:rgba(192,57,43,0.8);
--lm:rgba(170,160,40,0.3);--bdr:rgba(212,175,55,0.18);
--purple:#8B5CF6;--green:#22C55E;--red:#EF4444;--blue:#3B82F6;
}
.light-mode {
--bg:#F5F0E8;--surf:#FFFFFF;--surf2:#F0EBE0;--surf3:#E8E0D0;
--text:#1A1208;--text-dim:#7A6A50;
--bdr:rgba(154,125,10,0.25);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
body{font-family:'Vazirmatn','Inter','Noto Kufi Arabic',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden;transition:background 0.3s,color 0.3s;}
body::before{content:'';position:fixed;inset:0;background:radial-gradient(ellipse at 15% 15%,rgba(212,175,55,0.06) 0%,transparent 55%),radial-gradient(ellipse at 85% 85%,rgba(139,92,246,0.05) 0%,transparent 55%);pointer-events:none;z-index:0;}
.light-mode body::before{background:radial-gradient(ellipse at 15% 15%,rgba(212,175,55,0.08) 0%,transparent 55%);}

/* SPLASH */
#splash{position:fixed;inset:0;background:var(--bg);z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.5rem;transition:opacity 0.6s;}
#splash.hidden{opacity:0;pointer-events:none;}
.splash-icon{font-size:6rem;animation:splashPulse 1s ease-in-out infinite alternate;}
.splash-title{font-family:'Cinzel',serif;font-size:2.2rem;font-weight:900;background:linear-gradient(135deg,var(--gold-l),var(--gold),var(--gold-d));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:4px;}
.splash-bar{width:200px;height:4px;background:var(--surf3);border-radius:2px;overflow:hidden;}
.splash-fill{height:100%;background:linear-gradient(90deg,var(--gold-d),var(--gold));border-radius:2px;width:0%;transition:width 0.1s;}
.splash-sub{font-size:0.75rem;color:var(--text-dim);letter-spacing:3px;}

/* LANG & THEME now inside settings */
.lang-toggle{display:flex;overflow:hidden;border-radius:10px;border:1px solid var(--bdr);}
.lang-btn{padding:6px 14px;font-size:0.8rem;font-weight:700;cursor:pointer;border:none;background:var(--surf2);color:var(--text-dim);font-family:inherit;transition:all 0.2s;}
.lang-btn.active{background:var(--gold-d);color:var(--gold-l);}
.theme-toggle{display:flex;overflow:hidden;border-radius:10px;border:1px solid var(--bdr);}
.theme-tbtn{padding:6px 14px;font-size:0.8rem;font-weight:700;cursor:pointer;border:none;background:var(--surf2);color:var(--text-dim);font-family:inherit;transition:all 0.2s;}
.theme-tbtn.active{background:var(--surf3);color:var(--text);}

/* SCREENS */
.screen{display:none;position:relative;z-index:1;min-height:100vh;}
.screen.active{display:flex;}

/* MENU */
#menuScreen{flex-direction:column;align-items:center;justify-content:center;padding:2rem 1.5rem;gap:1.6rem;}
.branding{text-align:center;animation:fadeDown 0.7s ease;}
.chess-king{font-size:5rem;filter:drop-shadow(0 0 35px rgba(212,175,55,0.7));animation:float 3.5s ease-in-out infinite;line-height:1;}
.game-title{font-family:'Cinzel',serif;font-size:2.5rem;font-weight:900;background:linear-gradient(135deg,var(--gold-l),var(--gold),var(--gold-d));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:4px;margin-top:0.5rem;}
.game-title-sub{font-size:0.85rem;color:var(--text-dim);margin-top:2px;font-family:'Cinzel',serif;letter-spacing:2px;}
.studio-name{font-family:'Cinzel',serif;font-size:0.7rem;color:var(--text-dim);letter-spacing:3px;margin-top:5px;text-transform:uppercase;}
.menu-card{background:var(--surf);border:1px solid var(--bdr);border-radius:20px;padding:1.6rem 1.5rem;width:100%;max-width:360px;box-shadow:0 24px 60px rgba(0,0,0,0.4);animation:fadeUp 0.7s ease 0.15s both;}
.sec-label{font-size:0.65rem;color:var(--text-dim);letter-spacing:2px;text-transform:uppercase;margin-bottom:0.6rem;margin-top:0.9rem;padding-left:2px;}
.sec-label:first-child{margin-top:0;}
.mbtn{width:100%;padding:0.85rem 1.1rem;margin-bottom:0.55rem;border-radius:11px;border:none;cursor:pointer;font-family:inherit;font-size:0.95rem;font-weight:600;transition:all 0.2s;display:flex;align-items:center;gap:0.7rem;}
.mbtn:last-child{margin-bottom:0;}
.mbtn-gold{background:linear-gradient(135deg,#B8860B,var(--gold));color:#0A0A0F;}
.mbtn-gold:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(212,175,55,0.3);}
.mbtn-sec{background:var(--surf2);color:var(--text);border:1px solid var(--bdr);}
.mbtn-sec:hover{background:var(--surf3);transform:translateY(-2px);}
.mbtn-purple{background:rgba(139,92,246,0.12);color:#A78BFA;border:1px solid rgba(139,92,246,0.22);}
.mbtn-purple:hover{background:rgba(139,92,246,0.22);transform:translateY(-2px);}
.mbtn-arrow{margin-right:auto;opacity:0.35;font-size:0.8rem;}

/* GENERIC SCREEN */
.gscreen{flex-direction:column;align-items:center;padding:1.5rem;gap:1.1rem;}
.shdr{width:100%;max-width:430px;display:flex;align-items:center;gap:0.9rem;direction:ltr;}
.back-btn{background:var(--surf2);border:1px solid var(--bdr);border-radius:9px;padding:6px 13px;color:var(--text);cursor:pointer;font-family:inherit;font-size:0.82rem;transition:all 0.2s;white-space:nowrap;}
.back-btn:hover{background:var(--surf3);}
.stitle{font-size:1.35rem;font-weight:700;color:var(--gold);}
.panel{background:var(--surf);border:1px solid var(--bdr);border-radius:15px;padding:0.4rem 1.1rem;width:100%;max-width:430px;}
.prow{display:flex;align-items:center;justify-content:space-between;padding:0.85rem 0;border-bottom:1px solid rgba(128,100,50,0.1);}
.prow:last-child{border-bottom:none;}
.rlabel{font-size:0.92rem;}
.rsub{font-size:0.7rem;color:var(--text-dim);margin-top:2px;}
.toggle{position:relative;width:48px;height:25px;flex-shrink:0;}
.toggle input{display:none;}
.ttrack{position:absolute;inset:0;background:var(--surf3);border-radius:13px;cursor:pointer;transition:0.3s;}
.ttrack::after{content:'';position:absolute;left:3px;top:3px;width:19px;height:19px;background:var(--text-dim);border-radius:50%;transition:0.3s;}
.toggle input:checked+.ttrack{background:var(--gold-d);}
.toggle input:checked+.ttrack::after{transform:translateX(23px);background:var(--gold);}
.sctrl{background:var(--surf2);border:1px solid var(--bdr);border-radius:7px;color:var(--text);padding:4px 9px;font-family:inherit;font-size:0.82rem;cursor:pointer;outline:none;}

/* SKINS */
#skinsScreen{flex-direction:column;align-items:center;padding:1.5rem;gap:1.1rem;}
.skin-grid{display:grid;grid-template-columns:1fr 1fr;gap:0.8rem;width:100%;max-width:430px;}
.skin-card{background:var(--surf);border:2px solid var(--bdr);border-radius:14px;padding:1rem;cursor:pointer;transition:all 0.2s;text-align:center;}
.skin-card:hover{border-color:var(--gold-d);transform:translateY(-2px);}
.skin-card.selected{border-color:var(--gold);box-shadow:0 0 16px rgba(212,175,55,0.3);}
.skin-preview{display:flex;justify-content:center;gap:4px;font-size:2rem;margin-bottom:0.5rem;}
.skin-name{font-size:0.82rem;font-weight:700;color:var(--text);}
.skin-desc{font-size:0.68rem;color:var(--text-dim);margin-top:2px;}
.skin-badge{display:inline-block;background:var(--gold-d);color:var(--gold-l);font-size:0.58rem;padding:2px 7px;border-radius:5px;margin-top:4px;font-weight:700;}

/* ABOUT */
.about-hero{text-align:center;padding:1.2rem;background:var(--surf);border:1px solid var(--bdr);border-radius:16px;width:100%;max-width:430px;}
.ah-icon{font-size:3rem;margin-bottom:0.4rem;}
.ah-title{font-family:'Cinzel',serif;font-size:1.3rem;color:var(--gold);}
.ah-sub{font-size:0.75rem;color:var(--text-dim);margin-top:3px;letter-spacing:2px;}
.feature-list { text-align: right; direction: rtl; margin-top: 15px; }
.feature-item { font-size: 0.8rem; margin-bottom: 8px; display: flex; align-items: center; gap: 8px; border-bottom: 1px dashed var(--bdr); padding-bottom: 6px; }
.feat-emoji { font-size: 1.1rem; min-width: 28px; }

/* ACHIEVEMENTS */
#achScreen{flex-direction:column;align-items:center;padding:1.5rem;gap:1.1rem;}
.ach-grid{display:grid;grid-template-columns:1fr 1fr;gap:0.7rem;width:100%;max-width:430px;}
.ach-card{background:var(--surf);border:1px solid var(--bdr);border-radius:13px;padding:0.9rem;display:flex;flex-direction:column;align-items:center;text-align:center;gap:0.3rem;position:relative;overflow:hidden;transition:all 0.2s;}
.ach-card.done{border-color:var(--gold-d);}
.ach-card.done::after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(212,175,55,0.07),transparent);pointer-events:none;}
.ach-card.locked{opacity:0.4;filter:grayscale(0.6);}
.ach-ico{font-size:2rem;}
.ach-nm{font-size:0.78rem;font-weight:700;}
.ach-ds{font-size:0.65rem;color:var(--text-dim);}
.ach-badge{position:absolute;top:5px;left:5px;background:var(--gold-d);color:var(--gold-l);font-size:0.55rem;padding:2px 5px;border-radius:5px;font-weight:700;}
.ach-prog{width:100%;height:3px;background:var(--surf3);border-radius:2px;margin-top:3px;}
.ach-prog-fill{height:100%;background:var(--gold);border-radius:2px;transition:width 0.5s;}

/* TOAST */
.ach-toast{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(120px);background:linear-gradient(135deg,#1A1A10,#2A2510);border:1px solid var(--gold-d);border-radius:13px;padding:11px 18px;display:flex;align-items:center;gap:11px;z-index:1000;transition:transform 0.4s cubic-bezier(0.34,1.56,0.64,1);box-shadow:0 8px 30px rgba(0,0,0,0.5);min-width:250px;max-width:310px;}
.ach-toast.show{transform:translateX(-50%) translateY(0);}
.at-icon{font-size:1.9rem;}
.at-lbl{font-size:0.6rem;color:var(--gold);letter-spacing:2px;text-transform:uppercase;font-weight:700;}
.at-name{font-size:0.9rem;font-weight:700;}
.at-desc{font-size:0.7rem;color:var(--text-dim);}

/* GAME */
#gameScreen{flex-direction:column;align-items:center;padding:0.7rem;gap:0.6rem;padding-top:48px;}
.game-hdr{width:100%;max-width:520px;display:flex;align-items:center;justify-content:space-between;gap:0.4rem;}
.pp{background:var(--surf);border:1px solid var(--bdr);border-radius:11px;padding:0.45rem 0.8rem;display:flex;align-items:center;gap:0.5rem;min-width:115px;transition:all 0.3s;}
.pp.active{border-color:var(--gold);box-shadow:0 0 16px rgba(212,175,55,0.22);background:var(--surf2);}
.p-avatar{font-size:1.4rem;}
.p-name{font-size:0.78rem;font-weight:600;line-height:1.3;}
.p-color{font-size:0.65rem;color:var(--text-dim);}
.adot{width:6px;height:6px;background:var(--gold);border-radius:50%;box-shadow:0 0 6px var(--gold);animation:pulse 1s infinite;display:none;margin-right:auto;}
.pp.active .adot{display:block;}
.cctr{display:flex;flex-direction:column;align-items:center;gap:4px;}
.back-sm{background:var(--surf2);border:1px solid var(--bdr);border-radius:7px;padding:4px 9px;color:var(--text);cursor:pointer;font-family:inherit;font-size:0.72rem;transition:all 0.2s;direction:ltr;}
.back-sm:hover{background:var(--surf3);}
.turn-badge{font-size:0.72rem;color:var(--text-dim);text-align:center;padding:3px 9px;background:var(--surf);border-radius:7px;border:1px solid var(--bdr);white-space:nowrap;}

/* BOARD */
#chessBoard{display:grid;grid-template-columns:repeat(8,1fr);border:3px solid var(--gold-d);border-radius:4px;box-shadow:0 0 50px rgba(212,175,55,0.12),0 20px 60px rgba(0,0,0,0.6);overflow:hidden;touch-action:none;}
.sq{display:flex;align-items:center;justify-content:center;cursor:pointer;position:relative;user-select:none;transition:filter 0.1s;}
.sq.light{background:var(--lsq);}
.sq.dark{background:var(--dsq);}
.sq.selected{background:var(--hi) !important;}
.sq.vm::after{content:'';width:30%;height:30%;background:rgba(0,0,0,0.2);border-radius:50%;position:absolute;}
.sq.vc::after{content:'';inset:4px;border:3px solid rgba(0,0,0,0.2);border-radius:3px;position:absolute;}
.sq.lf,.sq.lt{background:var(--lm) !important;}
.sq.ic{background:var(--chk) !important;}
.piece{line-height:1;z-index:2;pointer-events:none;transition:transform 0.1s;}
.sq:hover .piece{transform:scale(1.08);}
.coord{position:absolute;font-weight:700;opacity:0.45;font-size:9px;}
.coord.f{bottom:2px;right:3px;}
.coord.r{top:2px;left:3px;}
.sq.light .coord{color:var(--dsq);}
.sq.dark .coord{color:var(--lsq);}

/* CAPTURED */
.cap-bar{display:flex;flex-wrap:wrap;gap:1px;font-size:1rem;min-height:22px;max-width:520px;width:100%;padding:0 3px;}

/* HISTORY */
.hist-wrap{background:var(--surf);border:1px solid var(--bdr);border-radius:9px;padding:5px 11px;width:100%;max-width:520px;max-height:65px;overflow-y:auto;}
.hist-lbl{font-size:0.65rem;color:var(--text-dim);margin-bottom:3px;}
.hist-list{display:flex;flex-wrap:wrap;gap:3px;}
.mv-tag{background:var(--surf2);border-radius:4px;padding:2px 5px;font-size:0.7rem;font-family:monospace;}
.mv-tag.w{color:#F0D9B5;}.mv-tag.b{color:#B58863;}

/* CONTROLS */
.gctrl{display:flex;gap:0.45rem;flex-wrap:wrap;justify-content:center;max-width:520px;width:100%;}
.cbtn{background:var(--surf);border:1px solid var(--bdr);border-radius:8px;color:var(--text);padding:5px 11px;cursor:pointer;font-family:inherit;font-size:0.77rem;transition:all 0.2s;display:flex;align-items:center;gap:4px;}
.cbtn:hover{background:var(--surf3);transform:translateY(-1px);}

/* MODALS */
.mo{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.82);z-index:200;align-items:center;justify-content:center;backdrop-filter:blur(6px);}
.mo.active{display:flex;}
.md{background:var(--surf);border:1px solid var(--bdr);border-radius:19px;padding:1.8rem 1.6rem;max-width:310px;width:90%;text-align:center;animation:popIn 0.3s cubic-bezier(0.34,1.56,0.64,1);box-shadow:0 24px 60px rgba(0,0,0,0.6);}
.md-ico{font-size:3.2rem;margin-bottom:0.7rem;}
.md-title{font-size:1.35rem;font-weight:700;color:var(--gold);margin-bottom:0.35rem;}
.md-txt{color:var(--text-dim);margin-bottom:1.3rem;font-size:0.88rem;line-height:1.6;}
.md-btns{display:flex;gap:0.6rem;justify-content:center;flex-wrap:wrap;}
.mdbtn{padding:0.6rem 1.2rem;border-radius:9px;border:none;cursor:pointer;font-family:inherit;font-size:0.88rem;font-weight:600;transition:all 0.2s;}
.mdbtn-p{background:linear-gradient(135deg,#B8860B,var(--gold));color:#0A0A0F;}
.mdbtn-p:hover{transform:translateY(-2px);}
.mdbtn-s{background:var(--surf2);color:var(--text);border:1px solid var(--bdr);}
.mdbtn-s:hover{background:var(--surf3);}
.promo-row{display:flex;gap:0.6rem;justify-content:center;margin:0.9rem 0;}
.promo-btn{background:var(--surf2);border:2px solid var(--bdr);border-radius:11px;padding:0.7rem;font-size:2.2rem;cursor:pointer;transition:all 0.2s;}
.promo-btn:hover{border-color:var(--gold);transform:scale(1.1);}

/* MYKET BUTTONS */
.myket-btn{width:100%;padding:0.85rem 1.2rem;border-radius:12px;border:none;cursor:pointer;font-family:inherit;font-size:0.92rem;font-weight:700;display:flex;align-items:center;gap:0.8rem;transition:all 0.2s;margin-top:0.6rem;}
.myket-btn-blue{background:linear-gradient(135deg,#1A5276,#2980B9);color:#fff;}
.myket-btn-blue:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(41,128,185,0.4);}
.myket-btn-green{background:linear-gradient(135deg,#1a7a3c,#27AE60);color:#fff;}
.myket-btn-green:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(39,174,96,0.4);}
.myket-btn-orange{background:linear-gradient(135deg,#a04000,#E67E22);color:#fff;}
.myket-btn-orange:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(230,126,34,0.4);}
.myket-btn-red{background:linear-gradient(135deg,#922b21,#E74C3C);color:#fff;}
.myket-btn-red:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(231,76,60,0.4);}
.myket-section-title{font-size:0.68rem;color:var(--text-dim);letter-spacing:2px;text-transform:uppercase;margin:1rem 0 0.5rem;padding:0 2px;width:100%;max-width:430px;}

@keyframes fadeDown{from{opacity:0;transform:translateY(-20px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.3}}
@keyframes popIn{from{opacity:0;transform:scale(0.7)}to{opacity:1;transform:scale(1)}}
@keyframes splashPulse{from{filter:drop-shadow(0 0 20px rgba(212,175,55,0.4))}to{filter:drop-shadow(0 0 50px rgba(212,175,55,0.9))}}
</style>
</head>
<body>

<!-- SPLASH -->
<div id="splash">
<div class="splash-icon">♛</div>
<div class="splash-title">CHESS ROYALE</div>
<div class="splash-bar"><div class="splash-fill" id="splashFill"></div></div>
<div class="splash-sub">MIDNIGHT GAMES</div>
</div>

<!-- TOAST -->
<div class="ach-toast" id="achToast">
<div class="at-icon" id="atIcon">🏆</div>
<div style="flex:1">
<div class="at-lbl" id="atLbl">دستاورد!</div>
<div class="at-name" id="atName"></div>
<div class="at-desc" id="atDesc"></div>
</div>
</div>

<!-- MENU -->
<div id="menuScreen" class="screen active">
<div class="branding">
<div class="chess-king">♛</div>
<div class="game-title">CHESS ROYALE</div>
<div class="game-title-sub" id="menuSubtitle">شطرنج رویال</div>
<div class="studio-name">Midnight Games · V1.0.0</div>
</div>
<div class="menu-card">
<div class="sec-label" data-fa="بازی" data-en="PLAY" data-ar="العب">بازی</div>
<button class="mbtn mbtn-gold" onclick="snd('menuStart');startGame('friend')">
<span>👥</span><span data-fa="بازی با دوست" data-en="Play with Friend" data-ar="العب مع صديق">بازی با دوست</span><span class="mbtn-arrow">›</span>
</button>
<button class="mbtn mbtn-sec" onclick="snd('menuStart');startGame('ai')">
<span>🤖</span><span data-fa="بازی با هوش مصنوعی" data-en="Play vs AI" data-ar="العب ضد الذكاء">بازی با هوش مصنوعی</span><span class="mbtn-arrow">›</span>
</button>
<div class="sec-label" data-fa="شخصی‌سازی" data-en="CUSTOMIZE" data-ar="تخصيص">شخصی‌سازی</div>
<button class="mbtn mbtn-purple" onclick="snd('menuNav');showScreen('skinsScreen')">
