<div class="prow"><div class="rsub" data-fa="توسعه‌دهنده" data-en="Developer" data-ar="المطور">توسعه‌دهنده</div><div style="font-weight:700;font-family:'Cinzel',serif;color:var(--gold)">🌙 Midnight Games</div></div>
