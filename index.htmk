let currentSkin = SKINS[0];
let currentBoard = BOARD_THEMES[0];

function renderSkinGrid() {
const sg = document.getElementById('skinGrid');
const bg = document.getElementById('boardGrid');
sg.innerHTML = '';
bg.innerHTML = '';

SKINS.forEach(sk => {
const card = document.createElement('div');
card.className = 'skin-card' + (currentSkin.id === sk.id ? ' selected' : '');
const prevW = sk.w[4]; const prevB = sk.b[4];
const wStyle = sk.wStyle || ''; const bStyle = sk.bStyle || '';
card.innerHTML = `<div class="skin-preview"> <span style="${wStyle}">${prevW}</span> <span style="${bStyle}">${prevB}</span> </div> <div class="skin-name">${sk.name[lang]}</div>
<div class="skin-desc">${sk.desc[lang]}</div> ${sk.badge ? `<span class="skin-badge">${sk.badge}</span>` : ''}`;
card.onclick = () => {
currentSkin = sk;
let triedSkins = JSON.parse(localStorage.getItem('cr_skins')||'[]');
if(!triedSkins.includes(sk.id)){ triedSkins.push(sk.id); localStorage.setItem('cr_skins',JSON.stringify(triedSkins)); }
unlockAch('skin_all', triedSkins.length);
unlockAch('skin_change');
renderSkinGrid();
if (G) renderBoard();
};
sg.appendChild(card);
});

BOARD_THEMES.forEach(bt => {
const card = document.createElement('div');
card.className = 'skin-card' + (currentBoard.id === bt.id ? ' selected' : '');
card.innerHTML = `<div class="skin-preview" style="gap:2px"> <div style="width:28px;height:28px;background:${bt.l};border-radius:4px;border:1px solid rgba(0,0,0,0.1)"></div>
<div style="width:28px;height:28px;background:${bt.d};border-radius:4px"></div> </div> <div class="skin-name">${bt.name[lang]}</div>`;
card.onclick = () => {
currentBoard = bt;
let triedBoards = JSON.parse(localStorage.getItem('cr_boards')||'[]');
if(!triedBoards.includes(bt.id)){ triedBoards.push(bt.id); localStorage.setItem('cr_boards',JSON.stringify(triedBoards)); }
unlockAch('board_all', triedBoards.length);
document.documentElement.style.setProperty('--lsq', bt.l);
document.documentElement.style.setProperty('--dsq', bt.d);
renderSkinGrid();
if (G) renderBoard();
};
bg.appendChild(card);
});
}

