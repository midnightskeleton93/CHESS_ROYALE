<div class="md">
<div class="md-ico" id="cfIco">❓</div>
<div class="md-title" id="cfTitle"></div>
<div class="md-txt" id="cfTxt"></div>
<div class="md-btns">
<button class="mdbtn mdbtn-p" id="cfYes"></button>
<button class="mdbtn mdbtn-s" onclick="closeMo('confirmMo')" data-fa="نه" data-en="No" data-ar="لا">نه</button>
</div>
</div>
</div>
<div class="mo" id="secretCodeMo">
<div class="md">
<div class="md-ico">🔐</div>
<div class="md-title" data-fa="کد مخفی" data-en="Secret Code" data-ar="الرمز السري">کد مخفی</div>
<div class="md-txt" data-fa="لطفا کد را وارد کنید:" data-en="Please enter the code:" data-ar="الرجاء إدخال الرمز:">لطفا کد را وارد کنید:</div>
<input type="text" id="secretInput" placeholder="******" style="background: var(--surf2); border: 1px solid var(--bdr); color: var(--text); padding: 8px 12px; border-radius: 8px; width: 80%; margin-bottom: 15px; text-align: center; font-family: monospace;">
<div class="md-btns">
<button class="mdbtn mdbtn-p" onclick="verifySecretCode()" data-fa="تأیید" data-en="Confirm" data-ar="تأكيد">تأیید</button>
<button class="mdbtn mdbtn-s" onclick="closeMo('secretCodeMo')" data-fa="انصراف" data-en="Cancel" data-ar="إلغاء">انصراف</button>
</div>
</div>
</div>

<script>
// ============================================================
// SECRET UNLOCKABLES
// ============================================================
const SECRET_SKIN = {
id:'midnight',
name:{fa:'نیمه‌شب',en:'Midnight',ar:'منتصف الليل'},
desc:{fa:'هاله‌ای از رمز و راز',en:'Aura of mystery',ar:'هالة من الغموض'},
w:['🌙','🏰','🐺','🦇','🔮','👑'],
b:['✨','⚰️','🐉','🕸️','💀','🌑'],
wStyle:'color:#E0E0FF; text-shadow: 0 0 3px #A78BFA;',
bStyle:'color:#1A0033; text-shadow: 0 0 2px #C084FC;',
badge:'🔮'
};

const SECRET_BOARD = {
id:'midnight_theme', name:{fa:'نیمه‌شب (ویژه)',en:'Midnight (Special)',ar:'منتصف الليل (خاص)'}, l:'#0F1026', d:'#2A1B3D'
};

let secretUnlocked = false;

function unlockSecretContent() {
if(secretUnlocked) return;
secretUnlocked = true;
// Add to arrays if not already present
if(!SKINS.find(s => s.id === 'midnight')) SKINS.push(SECRET_SKIN);
if(!BOARD_THEMES.find(b => b.id === 'midnight_theme')) BOARD_THEMES.push(SECRET_BOARD);
localStorage.setItem('cr_secret_unlocked', 'true');
snd('ach');
alert({fa:'راز باستانی گشوده شد! اسکین و تم جدید اضافه شد.', en:'Ancient secret unlocked! New skin and theme added!', ar:'تم فتح السر القديم! تمت إضافة سمة ولون جديد!'}[lang]);
renderSkinGrid();
}

function checkSecretCode() {
document.getElementById('secretInput').value = '';
document.getElementById('secretCodeMo').classList.add('active');
}

function verifySecretCode() {
let code = document.getElementById('secretInput').value;
if(code === "Midnight") {
unlockSecretContent();
closeMo('secretCodeMo');
} else {
snd('bad');
alert({fa:'کد اشتباه است!', en:'Wrong code!', ar:'رمز خاطئ!'}[lang]);
closeMo('secretCodeMo');
}
}

// ============================================================
// SKINS SYSTEM
// ============================================================
// SKINS: order = [پیاده P, رخ R, اسب N, فیل B, وزیر Q, شاه K]
const SKINS = [
{ id:'classic',
name:{fa:'کلاسیک',en:'Classic',ar:'كلاسيكي'},
desc:{fa:'مهره‌های سنتی شطرنج',en:'Traditional chess pieces',ar:'قطع الشطرنج التقليدية'},
w:['♙','♖','♘','♗','♕','♔'],
b:['♟','♜','♞','♝','♛','♚'],
wStyle:'color:#FFFFF0; text-shadow: 0 1px 4px #333, 0 0 2px #555;',
bStyle:'color:#1A1A1A; text-shadow: 0 1px 4px rgba(255,255,255,0.4);',
badge:null },

{ id:'nature',
name:{fa:'طبیعت',en:'Nature',ar:'الطبيعة'},
desc:{fa:'حیوانات جنگل',en:'Forest animals',ar:'حيوانات الغابة'},
w:['🌸','🌲','🐴','🐘','🦋','🦁'],
b:['🌺','🌳','🦌','🐗','🦚','🐯'],
badge:null },

{ id:'space',
name:{fa:'فضا',en:'Space',ar:'الفضاء'},
desc:{fa:'تم کهکشانی',en:'Galaxy theme',ar:'موضوع المجرة'},
w:['⭐','🚀','👨‍🚀','🪐','🌙','☀️'],
b:['💫','🛸','👾','🌑','☄️','🌟'],
badge:'جدید' },

{ id:'medieval',
name:{fa:'قرون وسطی',en:'Medieval',ar:'العصور الوسطى'},
desc:{fa:'شوالیه‌ها و قلعه‌ها',en:'Knights & castles',ar:'الفرسان والقلاع'},
w:['🪖','🏰','🐎','🛡️','👑','⚔️'],
b:['⚙️','🏯','🗡️','🔱','💀','🧲'],
badge:null },

{ id:'ocean',
name:{fa:'اقیانوس',en:'Ocean',ar:'المحيط'},
desc:{fa:'دنیای زیر آب',en:'Underwater world',ar:'عالم تحت الماء'},
w:['🐟','🦀','🐠','🐙','🐬','🦈'],
b:['🐡','🦞','🦑','🪸','🐳','🐊'],
badge:null },

{ id:'royal',
name:{fa:'رویال',en:'Royal',ar:'ملكي'},
desc:{fa:'سبک شاهانه لاکچری',en:'Luxury royal style',ar:'الأسلوب الملكي الفاخر'},
w:['💎','🗼','🦄','💍','👸','🤴'],
b:['🖤','🏛️','🐉','🔮','🧙‍♀️','🧙'],
badge:'👑' },

{ id:'food',
name:{fa:'غذا',en:'Food',ar:'الطعام'},
desc:{fa:'مهره‌های خوردنی!',en:'Yummy pieces!',ar:'قطع لذيذة!'},
w:['🍕','🎂','🍩','🥑','🍰','🍔'],
b:['🌮','🍣','🍫','🍱','🍜','🍛'],
badge:'🍕' },

{ id:'halloween',
name:{fa:'هالووین',en:'Halloween',ar:'هالوين'},
desc:{fa:'ترسناک و بامزه',en:'Spooky & fun',ar:'مخيف وممتع'},
w:['💀','⚰️','🐺','🎃','🧙‍♀️','😈'],
b:['👻','🪦','🦇','🕷️','🧛','☠️'],
badge:'🎃' },

{ id:'sports',
name:{fa:'ورزشی',en:'Sports',ar:'رياضي'},
desc:{fa:'المپیک روی صفحه',en:'Olympics on board',ar:'الأولمبياد على اللوحة'},
w:['🏃','🏟️','🏇','🤼','🥊','🏆'],
b:['⚽','🎽','🏊','🎯','🥋','🔥'],
