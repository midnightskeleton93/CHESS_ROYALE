let AP = {};
try { AP = JSON.parse(localStorage.getItem('cr_ach') || '{}'); } catch(e) {}
function saveAP() { try { localStorage.setItem('cr_ach', JSON.stringify(AP)); } catch(e) {} }

function unlockAch(id, amt=1) {
const def = ACH.find(a => a.id === id); if (!def) return;
const prev = AP[id] || 0;
const nv = Math.min(prev + amt, def.max);
if (nv === prev) return;
AP[id] = nv; saveAP();
if (nv >= def.max && prev < def.max) showAchToast(def);
if (document.getElementById('achScreen').classList.contains('active')) renderAchGrid();
}

function showAchToast(def) {
snd('ach');
document.getElementById('atIcon').textContent = def.ico;
document.getElementById('atLbl').textContent = t('achUnlock');
document.getElementById('atName').textContent = def[lang] || def.fa;
document.getElementById('atDesc').textContent = def['d'+lang.charAt(0).toUpperCase()+lang.slice(1)] || def.dFa;
const toast = document.getElementById('achToast');
toast.classList.add('show');
setTimeout(() => toast.classList.remove('show'), 3500);
}

function renderAchGrid() {
const grid = document.getElementById('achGrid');
grid.innerHTML = '';
ACH.forEach(def => {
const prog = AP[def.id] || 0;
const done = prog >= def.max;
const card = document.createElement('div');
card.className = 'ach-card ' + (done ? 'done' : 'locked');
const name = def[lang] || def.fa;
const desc = def['d'+lang.charAt(0).toUpperCase()+lang.slice(1)] || def.dFa;
card.innerHTML = `${done ? '<div class="ach-badge">✓</div>' : ''}
<div class="ach-ico">${def.ico}</div>
<div class="ach-nm">${name}</div>
<div class="ach-ds">${desc}</div>
${def.max > 1 ? `<div class="ach-prog"><div class="ach-prog-fill" style="width:${Math.min(prog/def.max*100,100)}%"></div></div>` : ''}`;
grid.appendChild(card);
});
}

